{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E3 immutable identity artifact (Stage 1 fixtures; primary requires 2880 rows)",
  "type": "object", "additionalProperties": false,
  "required": ["run_id", "payload_seed", "originals"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "payload_seed": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "originals": {
      "type": "array", "minItems": 1, "maxItems": 2880,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["message_id", "client_id", "scheduled_offset_ns", "deadline_offset_ns", "payload_sha256", "expendable"],
        "properties": {
          "message_id": {"type": "integer", "minimum": 0, "maximum": 2879},
          "client_id": {"type": "integer", "minimum": 0, "maximum": 4294967295},
          "scheduled_offset_ns": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
          "deadline_offset_ns": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
          "payload_sha256": {"type": "array", "minItems": 32, "maxItems": 32, "items": {"type": "integer", "minimum": 0, "maximum": 255}},
          "expendable": {"type": "boolean"}
        }
      }
    }
  },
  "$comment": "Constructors additionally require row index=message_id and deadline>=schedule. Primary generation uses exactly 2880 rows, seed1, 80/s, deadline+2s. Stage1 small/fake-clock fixtures are not primary runs."
}
